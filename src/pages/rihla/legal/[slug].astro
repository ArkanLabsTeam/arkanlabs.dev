---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layout/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import { dateTimeToDateLong, ISOFormatDate } from "../../../lib/utils/general";

export const getStaticPaths = (async () => {
    const docs = await getCollection("rihlaLegal");
    return docs.map((doc) => {
        return {
            params: { slug: doc.id },
            props: {
                doc,
            },
        };
    });
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { Content } = await render(doc);

const classesForMarkdown = `
    prose max-w-none
    prose-a:text-accent
    prose-p:text-text
    prose-headings:text-text
    prose-strong:text-accent-2/75
    prose-ol:list-[lower-alpha]
    prose-li:text-text
`;

const lastUpdated = dateTimeToDateLong(doc.data.lastUpdated);
const effectiveDate = dateTimeToDateLong(doc.data.effectiveDate);
const dates = Object.entries(
     {
    "Effective Date": doc.data.lastUpdated,
    "Last Updated": doc.data.effectiveDate,
}
);

---

<BaseLayout title={doc.data.title}>
    <section
        class:list={[
            "border-border border-2 md:rounded-md rounded-sm p-4 bg-surface scroll-mt-20",
            "mb-20"
        ]}
    >
        <h1 class="text-4xl pb-4">{doc.data.title}</h1>
        <div class="pb-6">
            {
            dates.map(
                ([name, date]) => (
                            <p><span class="text-accent">{name}: </span><time datetime={ISOFormatDate(date)}>{dateTimeToDateLong(date)}</time></p>

                )
            )
        }
        </div>
        <div class={classesForMarkdown}>
            <Content />
        </div>
    </section>
    <script src="../../../lib/dots/cursor_tracker_desktop.ts"></script>

</BaseLayout>

