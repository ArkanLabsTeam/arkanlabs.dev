---
import SectionEyebrow from "./SectionEyebrow.astro";


type Props = {
    title: string,
    eyebrowTitle?: string,
    class?: string,
    id?: string
}

const { title, eyebrowTitle, class: className, id } = Astro.props;
---

<section
    class:list={[
        "border-border border-2 md:rounded-md rounded-sm p-4 bg-surface scroll-mt-20",
        className,
    ]}
    ,
    id={id}
>
    <SectionEyebrow title={eyebrowTitle} />
    <h2 class="md:text-2xl text-xl">{title}</h2>
    <slot />
</section>
