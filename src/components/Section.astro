---
import SectionEyebrow from "./SectionEyebrow.astro";

const { title, eyebrowTitle} = Astro.props;
---

<section class="border-border border-2 md:rounded-md rounded-sm p-4 bg-surface">
    <SectionEyebrow title={eyebrowTitle} />
    <h2 class="md:text-2xl text-xl">{title}</h2>
    <slot />
</section>