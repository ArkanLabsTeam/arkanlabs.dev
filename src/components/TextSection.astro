---
import type { HomeTextSection } from "../data/types";
import Section from "./Section.astro";

type Props = {
    section: HomeTextSection,
    class?: string
}


const { section, class: className } = Astro.props;
---

<Section title={section.title} eyebrowTitle={section.eyebrowTitle} class={className}>
    {
        section.segments.map((seg: string, index: number, ) => {
            return <p class="pt-4">{seg}</p>;
        })
    }
</Section>
