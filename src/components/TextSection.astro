---
import type { HomeTextSection } from "../data/types";
import Section from "./Section.astro";

type Props = {
    section: HomeTextSection
}


const { section } = Astro.props;
---

<Section title={section.title} eyebrowTitle={section.eyebrowTitle}>
    {
        section.segments.map((seg: string, index: number, ) => {
            return <p class="pt-4">{seg}</p>;
        })
    }
</Section>
