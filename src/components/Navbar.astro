---
import { SITE } from "../lib/utils/consts";

const links = [
    { href: "/projects", label: "Projects" },
    { href: "/roadmap", label: "Roadmap" },
];
const path = Astro.url.pathname;
---

<header
    class="sticky top-0 z-10 border-b border-border bg-surface/80 backdrop-blur mb-4"
>
    <nav
        class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 md:px-6"
    >
        <a
            href="/"
            class="font-unbounded text-lg font-semibold uppercase md:text-2xl"
        >
            {SITE.title}
        </a>
        <ul class="flex items-center gap-5 text-sm md:gap-8">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            class:list={[
                                "transition-colors hover:text-text",
                                path.startsWith(l.href)
                                    ? "text-accent-bright"
                                    : "text-muted",
                            ]}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
